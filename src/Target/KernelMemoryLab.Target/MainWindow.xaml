<Window x:Class="KernelMemoryLab.Target.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KernelMemoryLab Target"
        Width="980"
        Height="520"
        MinWidth="820"
        MinHeight="420"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="16"
                Background="#FFF3F6FA"
                BorderBrush="#FFD6DEE8"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Margin="0,0,10,0"
                           FontWeight="SemiBold"
                           Text="Process Name" />
                <TextBlock Grid.Row="0" Grid.Column="1"
                           Text="{Binding ProcessName}" />
                <TextBlock Grid.Row="0" Grid.Column="2"
                           Margin="24,0,10,0"
                           FontWeight="SemiBold"
                           Text="PID" />
                <TextBlock Grid.Row="0" Grid.Column="3"
                           Text="{Binding ProcessId}" />

                <TextBlock Grid.Row="2" Grid.Column="0"
                           Margin="0,0,10,0"
                           FontWeight="SemiBold"
                           Text="Test Block Base" />
                <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                         Padding="4,2"
                         IsReadOnly="True"
                         FontFamily="Consolas"
                         BorderThickness="0"
                         Background="Transparent"
                         Text="{Binding BaseAddress}" />
            </Grid>
        </Border>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Variables}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Width="*"
                                    Header="Variable Name"
                                    Binding="{Binding Name}" />
                <DataGridTextColumn Width="120"
                                    Header="Type"
                                    Binding="{Binding Type}" />
                <DataGridTextColumn Width="230"
                                    Header="Address"
                                    FontFamily="Consolas"
                                    Binding="{Binding Address}" />
                <DataGridTextColumn Width="180"
                                    Header="Current Value"
                                    Binding="{Binding CurrentValue}" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3"
                    Margin="0,14,0,0"
                    Orientation="Horizontal">
            <TextBlock FontWeight="SemiBold"
                       Text="Last Refresh Time: " />
            <TextBlock Text="{Binding LastRefreshTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss.fff zzz}}" />
            <TextBlock Margin="20,0,0,0"
                       Foreground="#FF52606D"
                       Text="Values are read directly from unmanaged memory every second." />
        </StackPanel>
    </Grid>
</Window>

